@model IEnumerable<Proyecto_Grupal.Models.EmpleadoDepartamento>

@{
    ViewData["Title"] = "Asignaciones";
}

<div class="site-container py-8">
    <div class="flex items-center justify-between mb-4">
        <h1 class="text-2xl font-bold">Asignación Empleado - Departamento</h1>
        <a class="btn-primary" asp-action="Create">Nueva asignación</a>
    </div>

    <div class="table-responsive">
        <table class="min-w-full bg-white border table">
            <thead>
                <tr class="bg-gray-100 text-left">
                    <th class="px-4 py-2">#</th>
                    <th class="px-4 py-2">Empleado</th>
                    <th class="px-4 py-2">Departamento</th>
                    <th class="px-4 py-2">Desde</th>
                    <th class="px-4 py-2">Hasta</th>
                    <th class="px-4 py-2">Activo</th>
                    <th class="px-4 py-2">Acciones</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var a in Model)
            {
                <tr class="border-t">
                    <td class="px-4 py-2">@a.Id</td>
                    <td class="px-4 py-2">@a.Empleado?.FirstName @a.Empleado?.LastName (@a.Empleado?.EmpNo)</td>
                    <td class="px-4 py-2">@a.Departamento?.DeptName</td>
                    <td class="px-4 py-2">@a.FromDate.ToString("yyyy-MM-dd")</td>
                    <td class="px-4 py-2">@(a.ToDate.HasValue ? a.ToDate.Value.ToString("yyyy-MM-dd") : "-")</td>
                    <td class="px-4 py-2">@(a.IsActive ? "Sí" : "No")</td>
                    <td class="px-4 py-2 table-actions">
                        <a asp-action="Edit" asp-route-id="@a.Id" class="btn-secondary btn-sm mr-2">Editar</a>
                        <a asp-action="Details" asp-route-id="@a.Id" class="btn btn-sm mr-2">Ver</a>
                        <form asp-action="ToggleActive" asp-route-id="@a.Id" method="post" class="inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn">@(a.IsActive ? "Desactivar" : "Activar")</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
