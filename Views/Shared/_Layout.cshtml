<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Proyecto_Grupal</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/Proyecto_Grupal.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.tailwind.css" asp-append-version="true" />
</head>
<body class="bg-gray-50 text-gray-800">
    <header class="bg-white border-b">
        <div class="site-container flex items-center justify-between py-4">
            <a class="text-2xl font-extrabold text-gray-900" asp-area="" asp-controller="Home" asp-action="Index">Proyecto_Grupal</a>

            <nav class="hidden md:flex space-x-6" aria-label="Primary">
                <a class="text-gray-700 hover:text-indigo-600" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                <a class="text-gray-700 hover:text-indigo-600" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </nav>

            <div class="md:hidden">
                <button id="mobile-menu-button" type="button" class="btn btn-primary">Menu</button>
            </div>
        </div>

        <div id="mobile-menu" class="hidden md:hidden bg-white border-t">
            <div class="site-container flex flex-col py-2">
                <a class="py-2 text-gray-700 hover:text-indigo-600" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                <a class="py-2 text-gray-700 hover:text-indigo-600" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </div>
    </header>

    <div class="site-container">
        <main role="main" class="pb-6">
            @RenderBody()
        </main>
    </div>

    <footer class="border-t text-muted">
        <div class="site-container py-6 text-sm text-gray-600">
            &copy; 2026 - Proyecto_Grupal - <a class="text-indigo-600 hover:text-indigo-700" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Simple mobile menu toggle using vanilla JS
        (function() {
            var btn = document.getElementById('mobile-menu-button');
            var menu = document.getElementById('mobile-menu');
            if (!btn) return;
            btn.addEventListener('click', function() {
                if (!menu) return;
                if (menu.classList.contains('hidden')) {
                    menu.classList.remove('hidden');
                } else {
                    menu.classList.add('hidden');
                }
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
