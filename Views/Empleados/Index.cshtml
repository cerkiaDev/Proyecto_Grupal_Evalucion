@model IEnumerable<Proyecto_Grupal.Models.Empleado>

@{
    ViewData["Title"] = "Empleados";
}

<div class="site-container py-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
        <div>
            <h1 class="text-2xl font-bold">Empleados</h1>
            <p class="text-muted mt-1">Listado de empleados registrados en el sistema.</p>
        </div>

        <div class="flex items-center gap-3">
            <form method="get" class="flex items-center gap-2">
                <input name="q" value="@Context.Request.Query["q"]" placeholder="Buscar por nombre, apellido o código" class="form-input" />
                <button type="submit" class="btn btn-secondary">Buscar</button>
            </form>
            <a class="btn-primary" asp-action="Create">Nuevo empleado</a>
        </div>
    </div>

    <div class="overflow-x-auto bg-white shadow-sm rounded-lg">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">#</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Emp No</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">CI</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nombre</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Género</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Fecha Nac.</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Ingreso</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Correo</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Activo</th>
                    <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100">
            @foreach (var e in Model)
            {
                <tr class="hover:bg-gray-50">
                    <td class="px-4 py-3 text-sm text-gray-700">@e.Id</td>
                    <td class="px-4 py-3 text-sm text-gray-700">@e.EmpNo</td>
                    <td class="px-4 py-3 text-sm text-gray-700">@e.CI</td>
                    <td class="px-4 py-3 text-sm text-gray-700">@e.FirstName @e.LastName</td>
                    <td class="px-4 py-3 text-sm text-gray-700">@e.Gender</td>
                    <td class="px-4 py-3 text-sm text-gray-700">@e.BirthDate.ToString("yyyy-MM-dd")</td>
                    <td class="px-4 py-3 text-sm text-gray-700">@e.HireDate.ToString("yyyy-MM-dd")</td>
                    <td class="px-4 py-3 text-sm text-gray-700">@e.Correo</td>
                    <td class="px-4 py-3 text-sm">
                        @if (e.IsActive) {
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800">Sí</span>
                        } else {
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-800">No</span>
                        }
                    </td>
                    <td class="px-4 py-3 text-right text-sm flex items-center justify-end gap-2">
                        <a asp-action="Details" asp-route-id="@e.Id" class="btn btn-secondary btn-sm">Ver</a>
                        <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-secondary btn-sm">Editar</a>
                        <form asp-action="ToggleActive" asp-route-id="@e.Id" method="post" class="inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn">@(e.IsActive ? "Desactivar" : "Activar")</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
